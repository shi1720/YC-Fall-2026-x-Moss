{
  "hosting": {
    "target": "raksha",
    "public": "deploy/firebase-public",
    "ignore": ["**/.*"],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "**",
        "run": { "serviceId": "raksha", "region": "asia-south1" }
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
