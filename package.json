{
  "name": "raksha",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "next build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "moss:seed": "tsx scripts/seed-moss.ts",
    "moss:status": "tsx scripts/moss-status.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:bench": "tsx scripts/bench.ts",
    "docs:pdf": "node scripts/render-docs.mjs",
    "engine:readme": "tsx scripts/engine-readme.ts",
    "eval:load": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@moss-js/moss": "^1.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.46.0",
    "motion": "^13.3.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "marked": "^18.0.13",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "description": "Raksha: the real-time scam-call shield. Sub-10 ms script recognition with Moss.",
  "type": "module"
}
